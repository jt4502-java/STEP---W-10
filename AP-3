
public class Main {

    static void rotateRoster(String[] names, int k) {

        int n = names.length;
        k = k % n;

        String[] result = new String[n];

        for (int i = 0; i < n; i++) {
            int newIndex = (i + k) % n;
            result[newIndex] = names[i];
        }

        System.out.print("Rotated Roster: [");

        for (int i = 0; i < n; i++) {
            System.out.print(result[i]);

            if (i < n - 1) {
                System.out.print(", ");
            }
        }

        System.out.println("]");
    }

    public static void main(String[] args) {

        String[] names = {"A", "B", "C", "D", "E"};

        int k = 2;

        rotateRoster(names, k);
    }
}
